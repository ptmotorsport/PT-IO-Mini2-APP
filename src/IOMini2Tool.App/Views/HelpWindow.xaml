<Window x:Class="IOMini2Tool.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help" Height="480" Width="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="TopicList" Grid.Column="0" Margin="0,0,12,0"
                 DisplayMemberPath="Title"
                 SelectionChanged="TopicList_SelectionChanged"/>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
